{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/cron/check-deadlines",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/cron/weekly-digest",
      "schedule": "10 23 * * 0"
    },
    {
      "path": "/cron/files-maintenance",
      "schedule": "0 0 * * *"
    }
  ]
}
